# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" on Render; leave unset or "development" locally
ENVIRONMENT=development

# ── Storage Buckets ───────────────────────────────────────────────────────────
PROFILE_PICTURES_BUCKET=profile-pictures
RESUMES_BUCKET=resumes


# ── SMTP Email (Optional - for sending actual OTP emails in production) ────────
# If not set, OTP codes are logged to the backend console for effortless testing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@aiml-batchfolio.edu
SMTP_TLS=true
